{
	"name": "extension",
	"version": "0.3.0",
	"private": true,
	"description": "Fill and copy your vauly items in the browser.",
	"type": "module",
	"scripts": {
		"dev": "wxt --port 5555",
		"dev:firefox": "wxt -b firefox",
		"build": "bun --bun wxt build",
		"build:firefox": "bun --bun wxt build -b firefox",
		"zip": "bun --bun wxt zip",
		"zip:firefox": "bun --bun wxt zip -b firefox",
		"check-types": "tsc --noEmit",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"@orpc/client": "catalog:",
		"@phosphor-icons/react": "^2.1.10",
		"@vauly/api": "workspace:*",
		"@vauly/crypto": "workspace:*",
		"@vauly/ui": "workspace:*",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tldts": "7.4.19"
	},
	"devDependencies": {
		"@simplewebauthn/server": "14.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/chrome": "^0.1.21",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@wxt-dev/module-react": "^1.1.5",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"web-ext": "^10.5.0",
		"wxt": "^0.21.3"
	}
}
